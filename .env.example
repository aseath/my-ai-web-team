# Docker Compose project name (prefix for containers, networks, volumes)
COMPOSE_PROJECT_NAME=changeme
# Host port published by the web (Apache) service
WEB_PORT=8080
# Host user/group IDs; www-data in the app container is remapped to these
UID=1000
GID=1000

# Application environment passed to the app container (local, production, ...)
APP_ENV=local
# Public base URL (canonical links, sitemap). Leave blank locally to use http://localhost:WEB_PORT
APP_URL=
# Contact form enquiries are sent here
CONTACT_EMAIL=

# Database credentials (read by both db init and the app)
# NOTE: MySQL only applies these on first initialisation of the db-data volume.
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root
